{
  "manifest_version": 3,
  "name": "YouTube截图翻译",
  "version": "1.0.0",
  "description": "框选 YouTube 视频画面，OCR 识别文字并翻译为中文",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://ocr.tencentcloudapi.com/*",
    "https://openapi.youdao.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/youtube-capture.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "打开设置"
  },
  "options_page": "src/options/index.html",
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "截图快捷键：框选截图并翻译"
    }
  }
}
